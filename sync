#!/bin/bash
#
# Tool to synchronize versioned and system dot files.
#
# Depends on:
# - rsync

set -euo pipefail

# Sync command (array preserves correct word-splitting/quoting)
SYNC=(rsync -a --delete --exclude=.git)

# Initialize flags
DRYRUN=0
CONFIRM=0
JOBS=0          # 0 = auto (number of CPUs); 1 = sequential
OPERATION=""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

function usage() {
    echo "Usage: sync [OPTIONS] OPERATION"
    echo ""
    echo "OPERATION:"
    echo "  in      Copy files from system folders to versioned folders"
    echo "  out     Copy files from versioned folders to system folders"
    echo ""
    echo "OPTIONS:"
    echo "  --confirm     Prompt for confirmation before each synchronization"
    echo "                (forces -j 1)"
    echo "  --dryrun      Show what would be done without performing actions"
    echo "  -j N          Max parallel jobs (default: number of CPUs; 1 = sequential)"
    echo "  --help        Show this help message"
    echo ""
    echo "Examples:"
    echo "  sync out                    # Copy all files to system (parallel)"
    echo "  sync --dryrun in            # Preview copying from system"
    echo "  sync --confirm out          # Copy to system with confirmation"
    echo "  sync -j 1 out               # Force one-at-a-time syncing"
    echo "  sync -j 4 out               # Cap parallelism at 4 jobs"
    exit "$1"
}

function check_dependencies() {
    if ! command -v rsync >/dev/null 2>&1; then
        echo -e "${RED}Error: rsync is required but not installed${NC}" >&2
        exit 1
    fi
}

function log_info() {
    echo -e "${BLUE}$1${NC}"
}

function log_success() {
    echo -e "${GREEN}$1${NC}"
}

function log_warning() {
    echo -e "${YELLOW}$1${NC}"
}

function log_error() {
    echo -e "${RED}$1${NC}" >&2
}

function parse_arguments() {
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --dryrun)
                DRYRUN=1
                ;;
            --confirm)
                CONFIRM=1
                ;;
            -j)
                shift
                if [[ ! "${1:-}" =~ ^[1-9][0-9]*$ ]]; then
                    log_error "-j requires a positive integer"
                    usage 1
                fi
                JOBS="$1"
                ;;
            --help)
                usage 0
                ;;
            in|out)
                if [[ -n "$OPERATION" ]]; then
                    log_error "Operation specified more than once"
                    usage 1
                fi
                OPERATION="$1"
                ;;
            -*)
                log_error "Unknown option: $1"
                usage 1
                ;;
            *)
                log_error "Unknown argument: $1"
                usage 1
                ;;
        esac
        shift
    done

    if [[ -z "$OPERATION" ]]; then
        log_error "Missing operation. Expected 'in' or 'out'."
        usage 1
    fi
}

# Array of 'system | versioned' file couples
common=(
    # bash
    "$HOME/.config/bash/ | bash/"
    "$HOME/.bashrc | bash/bundle/bashrc"
    "$HOME/.bash_profile | bash/bundle/bash_profile"
    "$HOME/.profile | bash/bundle/profile"
    "$HOME/.inputrc | bash/bundle/inputrc"
    # fish
    "$HOME/.config/fish/config.fish | fish/config.fish"
    "$HOME/.config/fish/conf.d/ | fish/conf.d/"
    # systemd
    "$HOME/.config/systemd/ | systemd/"
    # gnupg
    "$HOME/.gnupg/gpg-agent.conf | gnupg/gpg-agent.conf"
    # fonts configuration
    "$HOME/.config/fontconfig/ | fontconfig/"
    # git
    "$HOME/.config/git/ | git/"
    # helix
    "$HOME/.config/helix/ | helix/"
    # zellij
    "$HOME/.config/zellij/ | zellij/"
    # niri
    "$HOME/.config/niri/ | niri/"
    # noctalia
    "$HOME/.config/noctalia/ | noctalia/"
    # fuzzel
    "$HOME/.config/fuzzel/ | fuzzel/"
    # mako
    "$HOME/.config/mako/ | mako/"
    # swaylock
    "$HOME/.config/swaylock/ | swaylock/"
    # rofimoji
    "$HOME/.config/rofimoji.rc | rofimoji/rofimoji.rc"
    # alacritty
    "$HOME/.config/alacritty/ | alacritty/"
    # paru
    "$HOME/.config/paru/ | paru/"
    # yazi
    "$HOME/.config/yazi/ | yazi/"
    # gitui
    "$HOME/.config/gitui/ | gitui/"
    # zathura
    "$HOME/.config/zathura/ | zathura/"
    # tridactyl
    "$HOME/.config/tridactyl/ | tridactyl/"
    # lldb
    "$HOME/.lldbinit | lldb/lldbinit"
    "$HOME/.lldb/scripts/ | lldb/scripts/"
    # Mime associations
    "$HOME/.config/mimeapps.list | misc/mimeapps.list"
    # ssh
    "$HOME/.ssh/config | ssh/config"
    # OTP tool
    "$HOME/.config/otp/ | otp/"
    # imv
    "$HOME/.config/imv/ | imv/"
    # aichat
    "$HOME/.config/aichat/ | aichat/"
    # opencode
    "$HOME/.config/opencode/ | opencode/"
)

behemoth=(
    # wayvnc
    "$HOME/.config/wayvnc/ | wayvnc/"
    # samba
    "/etc/samba/smb.conf | samba/smb.conf"
    # evremap
    "/etc/evremap.toml | evremap/evremap.toml"
)

workmule=(
    # evremap
    "/etc/evremap.toml | evremap/evremap.toml"
)

function sync_single_file() {
    local in_file="$1"
    local out_file="$2"
    
    # Return codes: 0 = synced, 1 = error, 2 = skipped
    if [[ ! -e "$in_file" ]]; then
        log_warning "  ⚠ Skipping non-existent source: $in_file"
        return 2
    fi

    if [[ $DRYRUN == 1 ]]; then
        echo "  [DRY RUN] $in_file -> $out_file"
        return 0
    fi

    if [[ $CONFIRM == 1 ]]; then
        printf "  Proceed with %s -> %s [N/y]? " "$in_file" "$out_file"
        read -r confirmed
    else
        confirmed="y"
    fi

    if [[ $confirmed != "y" ]]; then
        echo "  Skipped: $in_file -> $out_file"
        return 2
    fi

    mkdir -p "$(dirname "$out_file")"
    if "${SYNC[@]}" "$in_file" "$out_file"; then
        log_success "  ✓ $in_file -> $out_file"
        return 0
    else
        log_error "  ✗ Failed to sync $in_file -> $out_file"
        return 1
    fi
}

# Resolve a "system | versioned" map entry into in/out paths for the current
# OPERATION. Sets the global RESOLVED_IN / RESOLVED_OUT.
function resolve_entry() {
    local target="$1" file="$2"
    local system_file local_file

    system_file=${file%%|*}
    local_file=${file#*|}
    # Trim surrounding whitespace
    system_file=${system_file#"${system_file%%[![:space:]]*}"}
    system_file=${system_file%"${system_file##*[![:space:]]}"}
    local_file=${local_file#"${local_file%%[![:space:]]*}"}
    local_file=${local_file%"${local_file##*[![:space:]]}"}
    local_file="$target/$local_file"

    if [[ $OPERATION == "out" ]]; then
        RESOLVED_IN=$local_file
        RESOLVED_OUT=$system_file
    else
        RESOLVED_IN=$system_file
        RESOLVED_OUT=$local_file
    fi
}

function sync_files() {
    local target="$1"
    shift
    local files=("$@")

    log_info "[$target]"

    local sync_count=0
    local skip_count=0
    local error_count=0

    # --confirm reads from stdin per entry, which cannot be interleaved across
    # parallel jobs, so force sequential when confirming.
    local max_jobs=1
    if [[ $CONFIRM == 0 ]]; then
        max_jobs=$JOBS
        [[ $max_jobs -le 0 ]] && max_jobs=$(nproc 2>/dev/null || echo 4)
    fi

    if [[ $max_jobs -le 1 ]]; then
        # Sequential path
        local file rc
        for file in "${files[@]}"; do
            resolve_entry "$target" "$file"
            set +e
            sync_single_file "$RESOLVED_IN" "$RESOLVED_OUT"
            rc=$?
            set -e
            case $rc in
                0) sync_count=$((sync_count + 1)) ;;
                2) skip_count=$((skip_count + 1)) ;;
                *) error_count=$((error_count + 1)) ;;
            esac
        done
    else
        # Parallel path: keep at most max_jobs background jobs in flight,
        # tracking each PID's outcome via its exit code.
        local file rc pid
        declare -A pids=()
        for file in "${files[@]}"; do
            resolve_entry "$target" "$file"
            sync_single_file "$RESOLVED_IN" "$RESOLVED_OUT" &
            pids[$!]=1

            if [[ ${#pids[@]} -ge $max_jobs ]]; then
                # Wait for any one job to finish, then tally it
                wait -n -p pid
                rc=$?
                unset 'pids[$pid]'
                case $rc in
                    0) sync_count=$((sync_count + 1)) ;;
                    2) skip_count=$((skip_count + 1)) ;;
                    *) error_count=$((error_count + 1)) ;;
                esac
            fi
        done
        # Drain the rest
        for pid in "${!pids[@]}"; do
            set +e
            wait "$pid"
            rc=$?
            set -e
            case $rc in
                0) sync_count=$((sync_count + 1)) ;;
                2) skip_count=$((skip_count + 1)) ;;
                *) error_count=$((error_count + 1)) ;;
            esac
        done
    fi

    log_info "Completed: $sync_count synced, $skip_count skipped, $error_count errors"
}

function main() {
    check_dependencies
    parse_arguments "$@"

    if [[ -z "${HOSTNAME:-}" ]]; then
        HOSTNAME=$(hostname)
    fi

    log_info "Starting sync operation: $OPERATION"
    if [[ $DRYRUN == 1 ]]; then
        log_info "DRY RUN MODE - No files will be modified"
    fi

    # Sync common files
    sync_files "common" "${common[@]}"

    # Sync system specific files if they exist
    if declare -p "$HOSTNAME" >/dev/null 2>&1; then
        declare -n file_list="$HOSTNAME"
        sync_files "$HOSTNAME" "${file_list[@]}"
    else
        log_warning "No specific configuration found for hostname: $HOSTNAME"
    fi

    log_success "Sync operation completed"
}

# Run main function with all arguments
main "$@"
