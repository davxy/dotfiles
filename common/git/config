[core]
editor = hx
pager = delta

# [interactive]
# diffFilter = delta --color-only

[gui]
editor = hx

[diff]
tool = meld

[merge]
tool = meld

[commit]
gpgsign = true

[push]
autoSetupRemote = true

[difftool]
prompt = false

[credential]
helper = cache --timeout=3600

[alias]
alias = config --get-regexp ^alias.
full-graph = log --graph --all --abbrev-commit --decorate=short --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
graph = log --graph --abbrev-commit --decorate=short --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
l = log -9 --abbrev-commit --decorate=short --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
copy = clone --depth 1
root = rev-parse --show-toplevel
# Utilities
co = "!git branch | fzf | tr -d ' *' | xargs git checkout"
prune-gone = "!git branch -vv | grep ': gone' | awk '{print $1}' | xargs -r git branch -D"
# Terse aliasas
g = graph
s = status -s
b = branch --color=always --format='%(if)%(HEAD)%(then)%(color:red)+%(color:reset)%(else)%(if)%(worktreepath)%(then)%(color:white)+%(color:reset)%(else) %(end)%(end) %(color:green)%(refname:short)%(color:reset) %(color:yellow)%(objectname:short)%(color:reset) %(if)%(HEAD)%(then)%(else)%(if)%(worktreepath)%(then)(%(worktreepath)) %(end)%(end)%(if)%(upstream)%(then)[%(color:blue)%(upstream:short)%(color:reset)%(if)%(upstream:track)%(then): %(upstream:track)%(end)]%(end)'
a = add
c = commit
p = pull
f = fetch
r = remote -v
m = merge
w = worktree
wt = "!git worktree list | fzf | awk '{print $1}'"

[delta]
line-numbers = true
syntax-theme = gruvbox-dark
dark = true
navigate = true
plus-style = syntax
minus-style = syntax

