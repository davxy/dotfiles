PPT:          11.71 W  (cap =  25.00 W)"
    stub_output "df -h --output=used,size,pcent /" " Used  Size Use%
 454G  932G  53%"

    stub_output "ip route" "default via 10.212.54.1 dev wlan0 proto dhcp src 10.212.54.98 metric 1024
10.212.54.0/24 dev wlan0 proto kernel scope link src 10.212.54.98 metric 1024"
    stub_output "ip addr show wlan0" "3: wlan0: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu 1500 qdisc noqueue state UP group default qlen 1000
    link/ether 00:11:22:33:44:55 brd ff:ff:ff:ff:ff:ff
    inet 10.212.54.98/24 metric 1024 brd 10.212.54.255 scope global dynamic wlan0
       valid_lft 3000sec preferred_lft 3000sec
    inet6 fe80::1/64 scope link
       valid_lft forever preferred_lft forever"
    stub_output "iw dev wlan0 link" "Connected to da:42:bf:95:42:44 (on wlan0)
	SSID: LordOfThePings
	freq: 5180.0
	RX: 42661870 bytes (39434 packets)
	TX: 3783862 bytes (11142 packets)
	signal: -51 dBm
	rx bitrate: 1200.9 MBit/s 80MHz HE-MCS 11 HE-NSS 2 HE-GI 0 HE-DCM 0"
    stub_output "ip -br link show up type wireguard" "wg0              UNKNOWN        <POINTOPOINT,NOARP,UP,LOWER_UP> "

    stub_output "bluetoothctl show" "Controller B0:A4:60:ED:B2:13 (public)
	Manufacturer: 0x0002 (2)
	Name: behemoth
	Alias: behemoth
	Powered: yes
	PowerState: on
	Discoverable: no"
    stub_output "bluetoothctl devices Connected" "Device 80:99:E7:F0:A6:C8 WH-1000XM6"
    stub_output "upower -e" "$headset
$display_device"
    stub_output "upower -i $headset" "  native-path:          /org/bluez/hci0/dev_80_99_E7_F0_A6_C8
  model:                WH-1000XM6
  serial:               80:99:E7:F0:A6:C8
  power supply:         no
  updated:              Mon 26 Oct 2026 05:18:07 PM CET (892 seconds ago)
  has history:          yes
  has statistics:       no
  headset
    warning-level:       none
