    stub_output "upower -i $display_device" "  power supply:         no
  updated:              Mon 26 Oct 2026 08:24:41 AM CET (32898 seconds ago)
  has history:          no
  has statistics:       no
  unknown
    warning-level:       none
    percentage:          0%
    icon-name:          'battery-missing-symbolic'"

    stub_output "wpctl get-volume @DEFAULT_AUDIO_SINK@" "Volume: 0.36"
    stub_output "wpctl inspect @DEFAULT_AUDIO_SINK@" "id 75, type PipeWire:Interface:Node
    audio.channels = \"2\"
  * media.class = \"Audio/Sink\"
  * node.description = \"WH-1000XM6\"
  * node.name = \"bluez_output.80_99_E7_F0_A6_C8.1\""
    stub_output "wpctl get-volume @DEFAULT_AUDIO_SOURCE@" "Volume: 0.50"
    stub_output "wpctl inspect @DEFAULT_AUDIO_SOURCE@" "id 80, type PipeWire:Interface:Node
  * media.class = \"Audio/Source\"
  * node.description = \"USB Microphone\""
    stub_output "$power_profile" 's "balanced"'
    stub_output "makoctl mode" default
}

# The script reads the batteries and the wireless flag of an interface in /sys.
# shellcheck disable=SC2016
run_info() {
    rm -f "$STUB_CALLS" "$STUB_BODY"
    timeout 20 unshare -rm bash -c 'mount --bind "$1/power_supply" /sys/class/power_supply &&
        mount --bind "$1/net" /sys/class/net && exec "$2"' _ "$fake_sys" "$system_info" > /dev/null
}

body() {
    cat "$STUB_BODY" 2>/dev/null
}

# The body line with the label, the text before ": ".
line() {
    body | grep -F " $1: "
}

# Device batteries are the only lines that end with a bare percent after the label.
device_battery_lines() {
    body | grep -E '^[^ ]+ [^:]+: [0-9]+%$'
}

failures=0

elapsed_ms() {
    local start=$1
    echo $(( (${EPOCHREALTIME/[.,]/} - ${start/[.,]/}) / 1000 ))
}

assert_eq() {
    local name=$1 expected=$2 actual=$3
    if [[ $expected == "$actual" ]]; then
        echo "ok   $name"
    else
        echo "FAIL $name"
        echo "  expected: $(printf '%q' "$expected")"
        echo "  actual:   $(printf '%q' "$actual")"
        failures=$((failures + 1))
    fi
}

# The lines come in a fixed order, so the eye finds each one at the same place. Load,
# temperature and power profile are together: the profile changes the other two.
# DisplayDevice of upower is not a device: it is the sum of the system batteries.
reset_state
run_info
assert_eq "all sources: body" "󰃰 Mon 26 Oct 17:26:14
󰔛 Uptime: 9 hours, 5 minutes
󰻠 Load: 1.18
󰔏 Temperature: CPU 44°C, GPU 61°C
󰓅 Power profile: balanced
󰍛 Memory: 7.1Gi/62Gi
󰋊 Disk: 454G/932G (53%)
󰁹 Battery: 81% (Discharging)
󰖟 Network: Connected
󰖩 wlan0: 10.212.54.98 (LordOfThePings, -51 dBm)
󰖂 VPN: wg0
󰂱 Bluetooth: WH-1000XM6
󰋋 WH-1000XM6: 82%
󰕾 Audio: WH-1000XM6 36%
󰍬 Microphone: USB Microphone 50%
󰂚 Do not disturb: off" "$(body)"

# The mako rules (timeout, size, shown in do-not-disturb mode) match the app name. The
# hint replaces the previous popup, so a second Mod+I does not add a second popup.
assert_eq "notification: app and replace hint" \
    "notify-send -h string:x-canonical-private-synchronous:protect -e -a system-info System Info" \
    "$(grep '^notify-send' "$STUB_CALLS")"

# A network that drops the packets must not stop the popup for the 10 s default wait.
assert_eq "network: ping waits 1 s at most" "ping -c 1 -W 1 8.8.8.8" "$(grep '^ping' "$STUB_CALLS")"

reset_state
STUB_PING_STATUS=1 run_info
assert_eq "network: down" "󰪎 Network: Disconnected" "$(line Network)"

# Mod+I must answer at once. The ping can take up to 1 s, so it must not add its time
# to the time of the other sources: one after the other, the two take 2 s here.
reset_state
start=$EPOCHREALTIME
STUB_PING_DELAY=1 STUB_SLOW=sensors run_info
elapsed=$(elapsed_ms "$start")
assert_eq "network: ping in parallel with the other sources" yes \
    "$( ((elapsed < 1700)) && echo yes || echo "no ($elapsed ms)")"
assert_eq "network: late ping, up" "󰖟 Network: Connected" "$(line Network)"

reset_state
STUB_PING_DELAY=1 STUB_PING_STATUS=1 run_info
assert_eq "network: late ping, down" "󰪎 Network: Disconnected" "$(line Network)"

# A wired interface has no SSID and no signal.
reset_state
stub_output "ip route" "default via 192.168.1.1 dev eth0 proto dhcp src 192.168.1.5 metric 100"
stub_output "ip addr show eth0" "    inet 192.168.1.5/24 brd 192.168.1.255 scope global dynamic eth0"
run_info
assert_eq "interface: wired" "󰈀 eth0: 192.168.1.5" "$(line eth0)"

reset_state
stub_empty "ip route"
run_info
assert_eq "interface: no default route, no line" "" "$(body | grep -e ' wlan0: ' -e ' eth0: ')"

reset_state
battery 81 Charging
run_info
assert_eq "battery: charging" "󰂄 Battery: 81% (Charging)" "$(line Battery)"

reset_state
rm -r "$fake_sys/power_supply/BAT0"
run_info
assert_eq "battery: none, no line" "" "$(line Battery)"

# wpctl prints 0.08 for 8 %: the digits "008" are not an octal number.
reset_state
stub_output "wpctl get-volume @DEFAULT_AUDIO_SINK@" "Volume: 0.36 [MUTED]"
stub_output "wpctl get-volume @DEFAULT_AUDIO_SOURCE@" "Volume: 0.08 [MUTED]"
run_info
assert_eq "audio: muted" "󰖁 Audio: WH-1000XM6 36% muted" "$(line Audio)"
assert_eq "microphone: muted, 8 %" "󰍭 Microphone: USB Microphone 8% muted" "$(line Microphone)"

reset_state
stub_output "makoctl mode" "default
do-not-disturb"
run_info
assert_eq "do-not-disturb: on" "󰂛 Do not disturb: on" "$(line "Do not disturb")"

# makoctl can have no mode at all, and do not disturb is then off.
reset_state
stub_empty "makoctl mode"
run_info
assert_eq "do-not-disturb: no mode is off" "󰂚 Do not disturb: off" "$(line "Do not disturb")"

# Powered is "no" also when rfkill blocks the controller.
reset_state
stub_output "bluetoothctl show" "Controller B0:A4:60:ED:B2:13 (public)
	Powered: no
	PowerState: off-blocked"
run_info
assert_eq "bluetooth: off" "󰂲 Bluetooth: off" "$(line Bluetooth)"

reset_state
stub_empty "bluetoothctl devices Connected"
run_info
assert_eq "bluetooth: on, no device" "󰂯 Bluetooth: on" "$(line Bluetooth)"

reset_state
stub_output "bluetoothctl devices Connected" "Device 80:99:E7:F0:A6:C8 WH-1000XM6
Device D4:3A:2C:11:22:33 MX Master 3S"
run_info
assert_eq "bluetooth: two devices" "󰂱 Bluetooth: WH-1000XM6, MX Master 3S" "$(line Bluetooth)"

reset_state
start=$EPOCHREALTIME
STUB_BLUETOOTH_HANG=1 run_info
elapsed=$(elapsed_ms "$start")
assert_eq "bluetooth: bluetoothd hangs, popup within 3 s" yes "$( ((elapsed < 3000)) && echo yes || echo "no ($elapsed ms)")"
assert_eq "bluetooth: bluetoothd hangs, no line" "" "$(line Bluetooth)"
assert_eq "bluetooth: bluetoothd hangs, later lines kept" "󰂚 Do not disturb: off" "$(line "Do not disturb")"

# On a laptop, upower also lists the system battery and the charger: they are power
# supplies, and the Battery line already shows the system battery. A device without a
# model takes the name of its type.
reset_state
mouse=/org/freedesktop/UPower/devices/mouse_dev_D4_3A_2C_11_22_33
keyboard=/org/freedesktop/UPower/devices/keyboard_dev_D4_3A_2C_44_55_66
stub_output "upower -e" "/org/freedesktop/UPower/devices/line_power_AC
/org/freedesktop/UPower/devices/battery_BAT0
$mouse
$keyboard
$display_device"
stub_output "upower -i /org/freedesktop/UPower/devices/line_power_AC" "  native-path:          AC
  power supply:         yes
  line-power
    online:              yes"
stub_output "upower -i /org/freedesktop/UPower/devices/battery_BAT0" "  native-path:          BAT0
  model:                5B10W13930
  power supply:         yes
  battery
    percentage:          81%"
stub_output "upower -i $mouse" "  model:                MX Master 3S
  power supply:         no
  mouse
    percentage:          40%"
stub_output "upower -i $keyboard" "  power supply:         no
  keyboard
    percentage:          70%"
run_info
assert_eq "device batteries: only devices, icon of the type" "󰍽 MX Master 3S: 40%
󰌌 keyboard: 70%" "$(device_battery_lines)"

reset_state
stub_output "ip -br link show up type wireguard" "wg0              UNKNOWN        <POINTOPOINT,NOARP,UP,LOWER_UP>
wg1              UNKNOWN        <POINTOPOINT,NOARP,UP,LOWER_UP> "
run_info
assert_eq "vpn: two interfaces" "󰖂 VPN: wg0, wg1" "$(line VPN)"

reset_state
stub_empty "ip -br link show up type wireguard"
run_info
assert_eq "vpn: none, no line" "" "$(line VPN)"

# An Intel CPU has "Package id 0" and not Tctl. Not all GPUs have a sensor.
reset_state
stub_output sensors "coretemp-isa-0000
Adapter: ISA adapter
Package id 0:  +55.0°C  (high = +100.0°C, crit = +100.0°C)
Core 0:        +50.0°C  (high = +100.0°C, crit = +100.0°C)"
run_info
assert_eq "temperature: intel, no GPU" "󰔏 Temperature: CPU 55°C" "$(line Temperature)"

reset_state
stub_output sensors "nvme-pci-0100
Adapter: PCI adapter
Composite:    +35.9°C  (low  = -20.1°C, high = +89.8°C)"
run_info
assert_eq "temperature: no CPU and no GPU, no line" "" "$(line Temperature)"

# No source of the new lines answers: the popup keeps the lines that do not need them.
reset_state
for key in sensors "df -h --output=used,size,pcent /" "uptime -p" "ip -br link show up type wireguard" \
    "bluetoothctl show" "upower -e" "wpctl get-volume @DEFAULT_AUDIO_SINK@" \
    "wpctl get-volume @DEFAULT_AUDIO_SOURCE@" "$power_profile" "makoctl mode"; do
    stub_fails "$key"
done
run_info
assert_eq "all new sources fail: only the other lines" "󰃰 Mon 26 Oct 17:26:14
󰻠 Load: 1.18
󰍛 Memory: 7.1Gi/62Gi
󰁹 Battery: 81% (Discharging)
󰖟 Network: Connected
󰖩 wlan0: 10.212.54.98 (LordOfThePings, -51 dBm)" "$(body)"

if [[ $failures -gt 0 ]]; then
    echo "$failures failure(s)"
    exit 1
fi
echo "all tests passed"
