#!/bin/bash
# Checks scripts/system-info against stub commands and a fake /sys, without a running
# desktop. There is no bar, so the Mod+I popup is the only place that shows the state
# of the system. Each line tells one state, and its Nerd Font icon (the monospace font)
# changes with the state, so a look at the icons is enough. A source that is not there
# (no battery, no Bluetooth controller, no audio server) gives no line: not a broken
# line, and not a popup that comes late or never.

set -u

repo_dir=$(cd "$(dirname "$0")/.." && pwd)
system_info=${SYSTEM_INFO:-$repo_dir/scripts/system-info}

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

mkdir -p "$work_dir/bin"
export PATH=$work_dir/bin:$PATH
export STUB_DATA=$work_dir/data
export STUB_CALLS=$work_dir/calls.log
export STUB_BODY=$work_dir/body
fake_sys=$work_dir/sys

# Each stub prints the data file named by its command line ("/" written as "%"), and
# fails when the file is not there. An empty file is a command that prints nothing.
for command in date uptime free ip iw sensors df upower wpctl makoctl busctl bluetoothctl; do
    cat > "$work_dir/bin/$command" <<'STUB'
#!/bin/bash
# bluetoothctl waits forever when bluetoothd does not run.
[[ ${0##*/} == bluetoothctl && -n ${STUB_BLUETOOTH_HANG:-} ]] && exec sleep 30
[[ ${0##*/} == "${STUB_SLOW:-}" ]] && sleep 1
key="${0##*/}${*:+ $*}"
file=$STUB_DATA/${key//\//%}
[[ -f $file ]] || exit 1
cat "$file"
STUB
done

cat > "$work_dir/bin/ping" <<'STUB'
#!/bin/bash
echo "ping $*" >> "$STUB_CALLS"
sleep "${STUB_PING_DELAY:-0}"
exit "${STUB_PING_STATUS:-0}"
STUB

cat > "$work_dir/bin/notify-send" <<'STUB'
#!/bin/bash
echo "notify-send ${*:1:$#-1}" >> "$STUB_CALLS"
printf '%s' "${!#}" > "$STUB_BODY"
STUB
chmod +x "$work_dir/bin/"*

# stub_output "COMMAND ARGS" TEXT: the output of that command line.
stub_output() {
    local key=$1
    printf '%s\n' "$2" > "$STUB_DATA/${key//\//%}"
}

stub_empty() {
    local key=$1
    : > "$STUB_DATA/${key//\//%}"
}

stub_fails() {
    local key=$1
    rm -f "$STUB_DATA/${key//\//%}"
}

battery() {
    mkdir -p "$fake_sys/power_supply/BAT0"
    echo "$1" > "$fake_sys/power_supply/BAT0/capacity"
    echo "$2" > "$fake_sys/power_supply/BAT0/status"
}

headset=/org/freedesktop/UPower/devices/headset_dev_80_99_E7_F0_A6_C8
display_device=/org/freedesktop/UPower/devices/DisplayDevice
power_profile="busctl get-property org.freedesktop.UPower.PowerProfiles"
power_profile+=" /org/freedesktop/UPower/PowerProfiles org.freedesktop.UPower.PowerProfiles ActiveProfile"

# The outputs of this machine, with a battery, a VPN and a microphone added.
reset_state() {
    rm -rf "$STUB_DATA" "$fake_sys" "$STUB_CALLS" "$STUB_BODY"
    unset STUB_PING_STATUS STUB_PING_DELAY STUB_SLOW STUB_BLUETOOTH_HANG
    mkdir -p "$STUB_DATA" "$fake_sys/power_supply" "$fake_sys/net/wlan0/wireless" "$fake_sys/net/eth0"
    battery 81 Discharging

    stub_output "date +%a %d %b %H:%M:%S" "Mon 26 Oct 17:26:14"
    stub_output uptime " 17:26:14 up  9:05,  1 user,  load average: 1.18, 1.20, 1.10"
    stub_output "uptime -p" "up 9 hours, 5 minutes"
    stub_output "free -h" "               total        used        free      shared  buff/cache   available
Mem:            62Gi       7.1Gi        50Gi       512Mi       5.0Gi        55Gi
Swap:             0B          0B          0B"
    stub_output sensors "iwlwifi_1-virtual-0
Adapter: Virtual device
temp1:        +46.0°C

k10temp-pci-00c3
Adapter: PCI adapter
Tctl:         +44.0°C
Tccd1:        +35.2°C

nvme-pci-0100
Adapter: PCI adapter
Composite:    +35.9°C  (low  = -20.1°C, high = +89.8°C)
                       (crit = +94.8°C)

