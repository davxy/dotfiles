#!/bin/bash

lines=()

# Icons of the Nerd Font, the monospace font.
add() {
    local icon=$1 text=$2
    lines+=("$icon $text")
}

comma_list() {
    awk 'NR > 1 { printf ", " } { printf "%s", $0 }'
}

add_audio() {
    local label=$1 icon=$2 muted_icon=$3 device=$4 status name text
    status=$(wpctl get-volume "$device" 2>/dev/null)
    # wpctl prints the volume with two decimals, so its digits without the point are the percent.
    [[ $status =~ ^Volume:\ ([0-9]+)\.([0-9]{2}) ]] || return
    name=$(wpctl inspect "$device" 2>/dev/null | sed -n 's/^[ *]*node\.description = "\(.*\)"$/\1/p')
    text="$label: ${name:+$name }$((10#${BASH_REMATCH[1]}${BASH_REMATCH[2]}))%"
    if [[ $status == *MUTED* ]]; then
        add "$muted_icon" "$text muted"
    else
        add "$icon" "$text"
    fi
}

# The ping takes the most time, so it runs while the other sources answer.
ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1 &
ping_pid=$!

add 󰃰 "$(date '+%a %d %b %H:%M:%S')"

uptime_text=$(uptime -p 2>/dev/null)
[ -n "$uptime_text" ] && add 󰔛 "Uptime: ${uptime_text#up }"

load_avg=$(uptime | awk -F'load average:' '{print $2}' | awk '{print $1}' | sed 's/,//')
add 󰻠 "Load: $load_avg"

temperatures=$(sensors 2>/dev/null | sed -n -E \
    -e 's/^(Tctl|Package id 0): +\+([0-9]+).*/CPU \2°C/p' \
    -e 's/^edge: +\+([0-9]+).*/GPU \1°C/p' | comma_list)
[ -n "$temperatures" ] && add 󰔏 "Temperature: $temperatures"

# powerprofilesctl starts a Python interpreter, which takes 100 ms.
profile=$(busctl get-property org.freedesktop.UPower.PowerProfiles /org/freedesktop/UPower/PowerProfiles \
    org.freedesktop.UPower.PowerProfiles ActiveProfile 2>/dev/null | sed -n 's/^s "\(.*\)"$/\1/p')
[ -n "$profile" ] && add 󰓅 "Power profile: $profile"

add 󰍛 "$(free -h | awk '/^Mem:/ {printf "Memory: %s/%s", $3, $2}')"

read -r disk_used disk_size disk_percent < <(df -h --output=used,size,pcent / 2>/dev/null | tail -n 1)
[ -n "$disk_size" ] && add 󰋊 "Disk: $disk_used/$disk_size ($disk_percent)"

for battery in /sys/class/power_supply/BAT*; do
    capacity=$(cat "$battery/capacity" 2>/dev/null)
    status=$(cat "$battery/status" 2>/dev/null)
    if [ -n "$capacity" ]; then
        icon=󰁹
        [ "$status" = Charging ] && icon=󰂄
        add "$icon" "Battery: ${capacity}% (${status})"
        break
    fi
done

if wait "$ping_pid"; then
    add 󰖟 "Network: Connected"
else
    add 󰪎 "Network: Disconnected"
fi

active_interface=$(ip route | grep default | awk '{print $5}' | head -1)
if [ -n "$active_interface" ]; then
    ip_addr=$(ip addr show "$active_interface" | grep 'inet ' | awk '{print $2}' | cut -d'/' -f1)
    if [ -n "$ip_addr" ]; then
        if [ -d "/sys/class/net/$active_interface/wireless" ]; then
            link=$(iw dev "$active_interface" link 2>/dev/null)
            ssid=$(grep -oP 'SSID: \K.*' <<< "$link")
            if [ -z "$ssid" ]; then
                ssid=$(iw dev "$active_interface" info 2>/dev/null | grep -oP 'ssid \K.*')
            fi
            signal=$(grep -oP 'signal: \K.*' <<< "$link")
            wireless=$(printf '%s\n' "$ssid" "$signal" | grep . | comma_list)
            add 󰖩 "$active_interface: $ip_addr${wireless:+ ($wireless)}"
        else
            add 󰈀 "$active_interface: $ip_addr"
        fi
    fi
fi

vpn=$(ip -br link show up type wireguard 2>/dev/null | awk '{print $1}' | comma_list)
[ -n "$vpn" ] && add 󰖂 "VPN: $vpn"

# bluetoothctl waits forever when bluetoothd does not run.
powered=$(timeout 1 bluetoothctl show 2>/dev/null | sed -n 's/^\tPowered: //p')
if [ "$powered" = yes ]; then
    devices=$(timeout 1 bluetoothctl devices Connected 2>/dev/null | sed -n 's/^Device [^ ]* //p' | comma_list)
    if [ -n "$devices" ]; then
        add 󰂱 "Bluetooth: $devices"
    else
        add 󰂯 "Bluetooth: on"
    fi
elif [ "$powered" = no ]; then
    add 󰂲 "Bluetooth: off"
fi

for device in $(upower -e 2>/dev/null); do
    # DisplayDevice is the sum of the system batteries, and the system batteries are power supplies.
    [[ $device == */DisplayDevice ]] && continue
    info=$(upower -i "$device" 2>/dev/null)
    grep -q '^ *power supply: *no$' <<< "$info" || continue
    percentage=$(sed -n 's/^ *percentage: *//p' <<< "$info")
    [ -n "$percentage" ] || continue
    model=$(sed -n 's/^ *model: *//p' <<< "$info")
    device_type=${device##*/}
    device_type=${device_type%%_*}
    case $device_type in
        headset|headphones) icon=󰋋 ;;
        mouse) icon=󰍽 ;;
        keyboard) icon=󰌌 ;;
        *) icon=󰁹 ;;
    esac
    add "$icon" "${model:-$device_type}: $percentage"
done

add_audio Audio 󰕾 󰖁 @DEFAULT_AUDIO_SINK@
add_audio Microphone 󰍬 󰍭 @DEFAULT_AUDIO_SOURCE@

if modes=$(makoctl mode 2>/dev/null); then
    if grep -qx do-not-disturb <<< "$modes"; then
        add 󰂛 "Do not disturb: on"
    else
        add 󰂚 "Do not disturb: off"
    fi
fi

message=$(printf '%s\n' "${lines[@]}")
echo "$message"
notify-send -h string:x-canonical-private-synchronous:protect -e -a "system-info" "System Info" "$message"
