# Mega has no ChangeNotify, no hashes and no usable modtime.
# Polling does nothing, and "full" cache mode can serve stale reads
# (fingerprint is size only). Keep reads uncached and expire the
# directory cache so external changes appear within 5 minutes.
RCLONE_VFS_CACHE_MODE=writes
RCLONE_DIR_CACHE_TIME=5m
RCLONE_POLL_INTERVAL=0
