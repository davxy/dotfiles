# Gruvbox Material Dark, as alacritty, swaylock and the niri focus ring.

font=monospace 10
background-color=#282828
text-color=#d4be98
border-color=#d4be98
border-size=3
border-radius=3
padding=10
margin=15
progress-color=over #a9b6654d
default-timeout=3000
ignore-timeout=1

[app-name=system-info]
default-timeout=5000
width=400
height=200

# Last, because the last matching section wins: no app section can make a critical message expire.
[urgency=critical]
border-color=#ea6962
default-timeout=0
ignore-timeout=1
