# Gruvbox Material Dark, as alacritty, swaylock and the niri focus ring.

font=monospace 12
background-color=#282828
text-color=#d4be98
border-color=#d4be98
border-size=3
border-radius=3
padding=10
margin=15
progress-color=over #a9b6654d
default-timeout=3000
ignore-timeout=1

[app-name=system-info]
anchor=top-left
default-timeout=10000
width=450
height=400

[app-name=window-info]
anchor=top-left
default-timeout=10000
width=450
height=400

# Do not disturb (power menu) hides the messages, but not the notice that tells the mode is on,
# and not the system and window info that the user asks for with Mod+I and Mod+Shift+I.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb app-name=menu]
invisible=0

[mode=do-not-disturb app-name=system-info]
invisible=0

[mode=do-not-disturb app-name=window-info]
invisible=0

# Last, because the last matching section wins: no app section can make a critical message expire,
# and do not disturb cannot hide it.
[urgency=critical]
border-color=#ea6962
default-timeout=0
ignore-timeout=1
invisible=0
