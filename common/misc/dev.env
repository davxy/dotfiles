# Fish and POSIX shells both source this file.
# Use only `export NAME="value"` lines.

# Development folders
export DEV_ROOT="$(readlink -m "$HOME/develop")"
export DEV_ARK_VRF="$DEV_ROOT/crypto/ark-vrf"
export DEV_POLKAJAM="$DEV_ROOT/jam/polkajam"
export DEV_JAM_FUZZING="$DEV_ROOT/jam/jam-conformance/jam-fuzzing"
export DEV_JAM_TYPES="$DEV_ROOT/jam/jam-conformance/jam-types-py"
export DEV_JAM_TEST_VECTORS="$DEV_ROOT/jam/jam-conformance/jam-test-vectors"
export DEV_GRAYPAPER="$DEV_ROOT/jam/graypaper/graypaper"
export DEV_DATAWOK="$DEV_ROOT/personal/datawok"
export DEV_FEEDS="$DEV_ROOT/feeds"

# JAM specific
export JAM_VERSION="0.8.0"
export JAM_SOCK="/tmp/jam_target.sock"
export JAM_TYPES_PYTHON="$HOME/.local/pip/jam-types/bin/python"

# Polkajam specific
export POLKAJAM_FUZZ_BIN="$DEV_POLKAJAM/target/release/polkajam-fuzz"
